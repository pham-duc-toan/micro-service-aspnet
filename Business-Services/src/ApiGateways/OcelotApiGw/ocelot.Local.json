  "SwaggerEndPoints": [
    {
      "Key": "product-service",
      "Config": [
        {
          "Name": "Product API",
          "Version": "v1",
          "Url": "http://product.api/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "customer-service",
      "Config": [
        {
          "Name": "Customer API",
          "Version": "v1",
          "Url": "http://customer.api/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "basket-service",
      "Config": [
        {
          "Name": "Basket API",
          "Version": "v1",
          "Url": "http://basket.api/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "order-service",
      "Config": [
