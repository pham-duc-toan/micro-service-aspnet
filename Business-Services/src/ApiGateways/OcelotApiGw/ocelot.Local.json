    {
      "UpstreamPathTemplate": "/{version}/orders/document-no/{documentNo}",
      "UpstreamHttpMethod": [ "DELETE" ],
      "DownstreamPathTemplate": "/api/{version}/orders/document-no/{documentNo}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 6005
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [ "tedu_microservices_api.write" ]
      },
      "RouteClaimsRequirement": {
        "roles": "Administrator"
      },
      "SwaggerKey": "order-service"
    },

    // ============ Inventory API : http://inventory.product.api/api/inventory ============
