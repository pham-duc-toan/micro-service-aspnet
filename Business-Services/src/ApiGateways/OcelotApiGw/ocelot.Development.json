      "DownstreamPathTemplate": "/api/products/get-product-by-no/{productNo}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5002 } ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [ "tedu_microservices_api.read" ]
      },
      "SwaggerKey": "product-service"
    },
    {
      "UpstreamPathTemplate": "/products",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamPathTemplate": "/api/products",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5002 } ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [ "tedu_microservices_api.write" ]
      },
      "RouteClaimsRequirement": { "roles": "Administrator" },
      "SwaggerKey": "product-service"
    },
    {
      "UpstreamPathTemplate": "/products/{id}",
      "UpstreamHttpMethod": [ "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/api/products/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5002 } ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [ "tedu_microservices_api.write" ]
      },
      "RouteClaimsRequirement": { "roles": "Administrator" },
      "SwaggerKey": "product-service"
