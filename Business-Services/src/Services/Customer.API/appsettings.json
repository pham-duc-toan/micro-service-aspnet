{
    "DatabaseSettings": {
        "DBProvider": "postgresql",
        "ConnectionString": "Server=localhost;Port=5433;Database=CustomerDb;User Id=admin;Password=admin1234"
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Microsoft.AspNetCore.Authentication": "Debug",
                "System": "Warning"
            }
        }
    },
    "AllowedHosts": "*",
    "HangfireSettings": {
        "Route": "/jobs",
        "ServerName": "Customer Server",
        "Dashboard": {
            "AppPath": "/",
            "StatsPollingInterval": 5000,
            "DashboardTitle": "Hangfire Dashboard"
        },
        "Storage": {
            "DBProvider": "postgresql",
            "ConnectionString": "Server=localhost;Port=5433;Database=CustomerDb;User Id=admin;Password=admin1234"
        }
    },
    "ElasticConfiguration": {
        "Uri": "http://localhost:9200",
        "Username": "elastic",
        "Password": "admin"
    },
    "ApiConfig": {
        "ApiTitle": "Customer API",
        "ApiVersion": "v1",
        "ApiName": "tedu_microservices_api",
        "ApiBaseUrl": "http://localhost:6003",
        "IdentityServerBaseUrl": "http://localhost:6011",
        "IssuerUri": "http://localhost:6011",
        "ClientId": "tedu_microservices_swagger",
        "CorsAllowAnyOrigin": true,
        "CorsAllowOrigin": [
            "http://localhost:5001",
            "http://localhost:6011",
            "https://localhost:7011"
        ]
    }
}
