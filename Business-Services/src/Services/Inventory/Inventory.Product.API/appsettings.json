{
    "MongoDbSettings": {
        "DBProvider": "mongodb",
        "ConnectionString": "mongodb://localhost:27017",
        "DatabaseName": "InventoryDb"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ElasticConfiguration": {
        "Uri": "http://localhost:9200",
        "Username": "elastic",
        "Password": "admin"
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "Microsoft.AspNetCore.Authentication": "Debug",
                "System": "Warning"
            }
        }
    },
    "ApiConfig": {
        "ApiTitle": "Inventory API",
        "ApiVersion": "v1",
        "ApiName": "tedu_microservices_api",
        "ApiBaseUrl": "http://localhost:6006",
        "IdentityServerBaseUrl": "http://localhost:6011",
        "IssuerUri": "http://localhost:6011",
        "ClientId": "tedu_microservices_swagger",
        "CorsAllowAnyOrigin": true,
        "CorsAllowOrigin": [
            "http://localhost:5001",
            "http://localhost:6011",
            "https://localhost:7011"
        ]
    }
}
